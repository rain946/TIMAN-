# Full TIMAN backend API URL. Use your computer's LAN address for a physical device.
EXPO_PUBLIC_API_URL=http://10.0.21.147:3000/api

# Required backend security configuration. Use a long, random secret.
JWT_SECRET=replace-with-a-long-random-secret
NODE_ENV=development

# Optional comma-separated web origins. Native mobile requests have no Origin
# and remain allowed. Set production website origins in Railway, if used.
CORS_ALLOWED_ORIGINS=https://your-production-web-app.example

# Nearby lost-pet alert rules (backend only).
NEARBY_LOST_PET_RADIUS_KM=10
NEARBY_LOST_PET_ALERT_COOLDOWN_HOURS=6
NEARBY_LOST_PET_REBROADCAST_MIN_DISTANCE_KM=2
NEARBY_ALERT_LOCATION_MAX_AGE_DAYS=30
